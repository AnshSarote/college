void delbegin(struct node**start)
{ if(*start == NULL)
{
    printf("list is empty!\n");
    return;
}
    struct node* temp = *start;
  *start = (*start)->link;
  free(temp);
}
void delend(struct node**start)
{
    if(*start == NULL)
    {
        printf("List is empty!\n");
        return;
    }

struct node* temp = *start;
if(temp->link==NULL)
{
    free(temp);
    *start = NULL;
    return;
}
while(temp->link->link!= NULL)
    {
        temp = temp ->link;
    }
free(temp->link);
temp->link = NULL;
}
void delanypos(struct node**start, int pos)
{
    if(*start==NULL)
    {
        printf("list is empty!\n");
        return;
    }
    if(pos <1)
    {
        printf("invalid position!\n");
        return;
    }
    struct node* temp = *start;
    if(pos == 1)
    {
        *start = temp->link;
        free(temp);
        return;
    }
    for(int i =1 ; temp!=NULL && i<pos-1; i++)
        {
            temp = temp->link;
        }
    if(temp==NULL|| temp ->link==NULL)
    {
        printf("position out of range!\n");
        return;
    }
    struct node* dnode=temp->link;
    free(dnode);
}
