
#include<stdio.h>
#include <string.h>

void bubble( char arr[][50], int n )
{
    int pass=0;
    int swaps=0;
    for(int k=1; k<n; k++)
    { char temp[50];
        int ptr=0;
        int swap=0;
        while (ptr<=n-k-1)
        {
            if(strcmp (arr[ptr], arr[ptr+1]) >0)
            {
                strcpy (temp, arr[ptr]);
                strcpy(arr[ptr], arr[ptr+1]);
                strcpy (arr[ptr+1], temp);
                swap++;
                swaps++;
            }
            ptr = ptr+1;
        }
        pass++;
        
        if (swap==0)
        {
            break;
        }
    }
    printf("total passes : %d and total swaps : %d\n",pass,swaps);
}

int main() {
   int n;
   printf("enter the length of array: ");
   scanf("%d",&n);
   char arr[n][50];
   printf("enter the elements: \n ");
   for(int i=0 ; i<n; i++)
   {
       printf("enter the %d element : ",i+1);
       scanf("%s",arr[i]);
       
   }
   
      bubble(arr, n);
   printf(" the entire array is : \n");
   for ( int j=0; j<n; j++)
   {
       printf("  %s \n",arr[j]);
   }
   
   
}
