#include <stdio.h>

int front = 0, rear = 0;

void enqueue(int q[], int n) {
    int x;
    printf("Enter token: ");
    scanf("%d", &x);

    if ((front == 1 && rear == n) || front == rear + 1) {
        printf("Queue Overflow!\n");
        return;
    }
    if (front == 0){ 
        front = rear = 1;
    }
    else if (rear == n) {
        rear = 1;
    }
    else rear++;
    q[rear] = x;        
}
void dequeue(int q[], int n) {
    if (front == 0) {
        printf("Queue Underflow!\n");
        return;
    }

    printf("Passenger %d served.\n", q[front]);
    if (front == rear)
        front = rear = 0;
    else if (front == n)
        front = 1;
    else
        front++;
}
void display(int q[], int n) {
    if (front == 0) {
        printf("Queue is empty.\n");
        return;
    }
    int i = front;
    printf("Queue: ");
    while (1) {
        printf("%d ", q[i]);
        if (i == rear) break;
        i = (i == n) ? 1 : i + 1;
    }
    printf("\n");
}
int main() {
    int n, ch;
    printf("Enter queue size: ");
    scanf("%d", &n);
    int q[n + 1];
    while (1) {
        printf("\n1.Enqueue");
          printf("\n2.Dequeue ");
          printf("\n3.Display ");
          printf("\n4.Exit\n");
        scanf("%d", &ch);

        switch (ch) {
            case 1: enqueue(q, n); break;
            case 2: dequeue(q, n); break;
            case 3: display(q, n); break;
            case 4: return 0;
            default: printf("Invalid choice!\n");
        }
    }
